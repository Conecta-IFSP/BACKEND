MONGODB_URI=mongodb://localhost:27017/conecta-mais
PORT=3000

JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria

ROOT_USER_NAME=Administrador do Sistema
ROOT_USER_EMAIL=admin@admin.com
ROOT_USER_PASSWORD=troque-esta-senha

# Preencha para enviar e-mails reais. Sem estes dados, o link aparece no terminal.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Conecta+ <nao-responda@exemplo.com>

# Fallback para clientes que não enviam a URL dinâmica criada pelo Expo Go.
APP_RESET_URL=http://localhost:8081/login/redefinir-senha
