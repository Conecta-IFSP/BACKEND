MONGODB_URI=mongodb://localhost:27017/conecta-mais
PORT=3000

JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
API_ACCESS_TOKEN=troque-por-a-mesma-chave-do-EXPO_PUBLIC_API_ACCESS_TOKEN

ROOT_USER_NAME=Administrador do Sistema
ROOT_USER_EMAIL=admin@admin.com
ROOT_USER_PASSWORD=troque-esta-senha

# Preencha para enviar e-mails reais. Sem estes dados, o código aparece no terminal.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seu-email@gmail.com
MAIL_PASS=sua-senha-de-aplicativo(xxxx xxxx xxxx xxxx)
MAIL_FROM=Conecta+ <nao-responda@exemplo.com>

# Google OAuth 2.0 / OpenID Connect
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_IOS_CLIENT_ID=seu-client-id-ios.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=seu-client-id-android.apps.googleusercontent.com

# URL do frontend (para callback web do Google)
FRONTEND_URL=http://localhost:8081

# Para baixar o MongoDB, segue link baixo:
# https://fastdl.mongodb.org/windows/mongodb-windows-x86_64-6.0.29-signed.msi
